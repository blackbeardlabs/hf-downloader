{
  "name": "hf-downloader",
  "version": "1.3.3",
  "description": "Local Hugging Face and URL download manager using aria2c",
  "author": "blackbeardlabs",
  "license": "MIT",
  "homepage": "https://github.com/blackbeardlabs/hf-downloader",
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run rebuild:node && node server.js",
    "rebuild:node": "npm rebuild better-sqlite3",
    "electron": "npm run electron:rebuild && electron .",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm run electron:rebuild && electron-builder -c.npmRebuild=false",
    "dist:mac": "npm run electron:rebuild && electron-builder --mac dmg -c.npmRebuild=false",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:linux": "electron-builder --linux deb AppImage --x64",
    "dist:linux:arm64": "electron-builder --linux deb AppImage --arm64",
    "dist:all": "electron-builder --mac --win --linux"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "better-sqlite3": "^12.11.1",
    "dompurify": "^3.4.11",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.hf-downloader.app",
    "productName": "HF Downloader",
    "files": [
      "aria2.js",
      "db.js",
      "hf.js",
      "modelIndexer.js",
      "paths.js",
      "policy.js",
      "queue.js",
      "server.js",
      "settings.js",
      "system.js",
      "electron/**/*",
      "public/**/*",
      "node_modules/@fortawesome/fontawesome-free/**/*",
      "node_modules/marked/lib/**/*",
    "node_modules/dompurify/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "maintainer": "blackbeardlabs"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
